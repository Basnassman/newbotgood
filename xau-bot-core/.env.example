[TEMPLATE]
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية لاحقاً
# الآن (v1) متغيرات cTrader مطلوبة فقط عند استخدام CTraderPriceFeed الحقيقي
# (بيانات Mock تعمل بدون أي قيم)

# --- cTrader Open API (تُستخدم في brain/data/ctrader_price_feed.py) ---
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=
CTRADER_ENVIRONMENT=demo   # demo أو live — ابدأ دائماً بـ demo
# مطلوب للاتصال الفعلي: من openapi.ctrader.com → تطبيقك → Playground → access token
CTRADER_ACCESS_TOKEN=
# اختياري (أكثر ثباتاً): يُجدد رمز الوصول تلقائياً عند انتهائه
CTRADER_REFRESH_TOKEN=
# مهلة الاتصال/الاستجابة بالثواني (اختياري — الافتراضي 10)
CTRADER_CONNECTION_TIMEOUT_SECONDS=10

# --- مصدر الأخبار الاقتصادية (المرحلة القادمة) ---
ECONOMIC_CALENDAR_API_KEY=

# --- إعدادات المخاطر ---
RISK_PER_TRADE_PERCENT=1.0
MAX_DAILY_LOSS_PERCENT=5.0
ACCOUNT_BALANCE_USD=100

# --- عتبة القرار ---
DECISION_SCORE_THRESHOLD=75
